# Server
PORT=8888

# Database
DATABASE_PATH=./data/project-factory.db

# LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4
LLM_API_KEY=your-api-key
LLM_TEMPERATURE=0.7

# Workspace
WORKSPACE_ROOT=./projects

# Pipeline
PIPELINE_IDEA_GENERATION_ENABLED=true
PIPELINE_IDEA_GENERATION_INTERVAL=60000
PIPELINE_PROJECT_DEVELOPMENT_ENABLED=true
PIPELINE_ITERATION_ENABLED=true

# Quality thresholds
QUALITY_MIN_TEST_COVERAGE=80
QUALITY_MAX_LINT_ERRORS=0
QUALITY_MIN_QUALITY_SCORE=70

# Resource limits
RESOURCES_MAX_COST_PER_DAY=50
RESOURCES_MAX_CONCURRENT_PROJECTS=5
